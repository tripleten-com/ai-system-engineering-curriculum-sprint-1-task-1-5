        "ingestion_rate_calc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_readings_per_second",
            "growth_factor",
            "projected_readings_per_second",
            "payload_bytes_per_reading",
            "ingestion_bytes_per_second",
            "ingestion_mb_per_hour"
          ],
          "properties": {
            "baseline_readings_per_second": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0,
              "x-absolute-tolerance": 0.001
            },
            "growth_factor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0,
              "x-absolute-tolerance": 0.001
            },
            "projected_readings_per_second": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0,
              "x-absolute-tolerance": 0.001
            },
            "payload_bytes_per_reading": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "ingestion_bytes_per_second": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0,
              "x-absolute-tolerance": 0.001
            },
            "ingestion_mb_per_hour": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0,
              "x-absolute-tolerance": 0.001
            }
          }
        },
        "exception_rate_calc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projected_readings_per_second",
            "exception_fraction",
            "arrival_jobs_per_second"
          ],
          "properties": {
            "projected_readings_per_second": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0,
              "x-absolute-tolerance": 0.001
            },
            "exception_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "x-absolute-tolerance": 1e-06
            },
            "arrival_jobs_per_second": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0,
              "x-absolute-tolerance": 0.001
            }
          }
        },
        "storage_calc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ingestion_bytes_per_second",
            "retention_days",
            "seconds_per_day",
            "retained_bytes",
