            "scope"
          ],
          "properties": {
            "ingestion_bytes_per_second": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0,
              "x-absolute-tolerance": 0.001
            },
            "retention_days": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3650
            },
            "seconds_per_day": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "retained_bytes": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0,
              "x-absolute-tolerance": 0.001
            },
            "retained_decimal_gb": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0,
              "x-absolute-tolerance": 0.001
            },
            "scope": {
              "type": "string",
              "enum": [
                "raw-payload-only-excludes-indexes-replication-and-overhead",
                "fully-provisioned-production-storage"
              ]
            }
          }
        },
        "worker_count_calc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "service_seconds_per_job",
            "arrival_jobs_per_second",
            "unmargined_workers",
            "margin_fraction",
            "with_margin_workers",
            "required_workers",
            "rounding",
            "input_basis"
          ],
          "properties": {
            "service_seconds_per_job": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "x-absolute-tolerance": 1e-06
            },
            "arrival_jobs_per_second": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0,
              "x-absolute-tolerance": 0.001
            },
            "unmargined_workers": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000,
              "x-absolute-tolerance": 0.0001
            },
            "margin_fraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "x-absolute-tolerance": 1e-06
            },
            "with_margin_workers": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000,
              "x-absolute-tolerance": 0.0001
            },
            "required_workers": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "rounding": {
              "type": "string",
              "enum": [
                "ceil-once-after-one-margin",
                "ceil-before-margin",
                "round-nearest"
              ]
            },
            "input_basis": {
              "type": "string",
              "enum": [
                "pooled-worker-service-spans",
                "accepted-to-terminal-duration",
                "configured-delay-only"
              ]
            }
          }
        },
        "scaling_recommendation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
