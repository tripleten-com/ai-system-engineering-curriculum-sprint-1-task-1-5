                "admission-control-pilot",
                "multi-region-platform-migration"
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "bounded-local-pilot-before-production-decision",
                "immediate-production-rollout"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "x-order-independent": true,
              "items": {
                "type": "string",
                "enum": [
                  "E51",
                  "E52",
                  "E53",
                  "E54",
                  "E55",
                  "E56"
                ]
              }
            }
          }
        },
        "adr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context",
            "decision",
