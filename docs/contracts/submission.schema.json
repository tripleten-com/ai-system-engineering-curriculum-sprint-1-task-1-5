            "consequences",
            "action_trigger",
            "rollback_condition",
            "next_measurement"
          ],
          "properties": {
            "context": {
              "type": "string",
              "enum": [
                "projected-load-exceeds-one-worker-model",
                "cloud-capacity-already-proven"
              ]
            },
            "decision": {
              "type": "string",
              "enum": [
                "two-worker-pilot",
                "admission-control-pilot",
                "multi-region-platform-migration"
              ]
            },
            "alternatives": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "x-order-independent": true,
              "items": {
                "type": "string",
                "enum": [
                  "two-worker-pilot",
                  "admission-control-pilot",
                  "multi-region-platform-migration"
                ]
              }
            },
            "consequences": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "uniqueItems": true,
              "x-order-independent": true,
              "items": {
                "type": "string",
                "enum": [
                  "duplicate-and-database-contention-risk",
                  "admission-delay-and-rejection-risk",
                  "production-capacity-guaranteed"
                ]
              }
            },
            "action_trigger": {
              "type": "string",
              "enum": [
                "projected-utilization-above-one",
                "actual-arrivals-above-one-worker-modeled-rate",
                "local-api-p95-below-one-second"
              ]
            },
            "rollback_condition": {
              "type": "string",
              "enum": [
                "duplicate-side-effects-or-db-p95-over-200ms",
                "rejection-over-1-percent-or-oldest-age-over-60s",
                "never-rollback"
              ]
            },
            "next_measurement": {
              "type": "string",
              "enum": [
                "two-worker-completions-queue-age-db-p95-duplicates",
                "admission-rejections-queue-age-completions",
                "cloud-sla-from-local-runtime"
              ]
            }
          }
        }
      }
